# Salin menjadi functions/.env (cp functions/.env.example functions/.env) lalu isi.
# Ini BUKAN tempat API key. API key disimpan sebagai secret:
#   firebase functions:secrets:set ANTHROPIC_API_KEY

# Email Google yang otomatis menjadi admin saat pertama masuk (pisahkan dengan koma)
ADMIN_EMAILS=

# Opsional: batasi login ke satu domain email, mis. madrasahku.sch.id
ALLOWED_EMAIL_DOMAIN=

# Opsional: batas pembuatan soal AI per pengguna
LIMIT_PER_MINUTE=5
LIMIT_PER_DAY=60

# Opsional: ganti model
# ANTHROPIC_MODEL=claude-sonnet-5-5
